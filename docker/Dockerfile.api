# ── Dockerfile.api ─────────────────────────────────────────────
# FastAPI AQI Prediction Service
FROM python:3.11-slim

WORKDIR /app

# Install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir \
    fastapi==0.111.0 \
    uvicorn[standard]==0.30.0 \
    pydantic==2.7.1 \
    scikit-learn==1.5.0 \
    joblib==1.4.2 \
    numpy==1.26.4 \
    pandas==2.2.2

# Copy project
COPY api/         ./api/
COPY models/      ./models/
COPY logs/        ./logs/

ENV PYTHONPATH=/app

EXPOSE 8000
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]

# ============================================================
# .env.example
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
#
#   cp .env.example .env    (Linux/Mac)
#   copy .env.example .env  (Windows)
# ============================================================

# ----------------------------------------------------------
# PostgreSQL Database
# ----------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aqi_db
DB_USER=aqi_user
DB_PASSWORD=your_strong_password_here

# Full connection URL (used by SQLAlchemy)
DATABASE_URL=postgresql://aqi_user:your_strong_password_here@localhost:5432/aqi_db

# ----------------------------------------------------------
# OpenAQ API
# Free tier does not require a key for basic access.
# Register at https://api.openaq.org/ for higher rate limits.
# ----------------------------------------------------------
OPENAQ_API_KEY=your_openaq_api_key_here

# ----------------------------------------------------------
# MLflow
# ----------------------------------------------------------
# Local tracking (default). Change to a remote URI if needed.
MLFLOW_TRACKING_URI=http://localhost:5001

# ----------------------------------------------------------
# FastAPI
# ----------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# ----------------------------------------------------------
# Airflow
# ----------------------------------------------------------
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://aqi_user:your_strong_password_here@localhost:5432/airflow_db
AIRFLOW__CORE__FERNET_KEY=your_fernet_key_here
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__WEBSERVER__SECRET_KEY=your_secret_key_here

# ----------------------------------------------------------
# Streamlit
# ----------------------------------------------------------
STREAMLIT_PORT=8501

# ----------------------------------------------------------
# Docker / General
# ----------------------------------------------------------
COMPOSE_PROJECT_NAME=aqi_prediction
